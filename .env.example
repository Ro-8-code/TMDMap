# --- Supabase (auth: signup, email verification, login) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Ordnance Survey Data Hub (OS Maps API) ---
# Server-side only. Never prefixed with NEXT_PUBLIC_ so the key is never
# exposed to the browser; tiles are proxied through /api/tiles.
OS_API_KEY=your-os-data-hub-project-api-key

# --- Site URL (used for email verification redirect) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Alerts (uses the existing Google Workspace mailbox, not a new service) ---
# SMTP_PASSWORD is a Google App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@tmdesignservices.com
SMTP_PASSWORD=
ALERT_EMAIL=info@tmdesignservices.com
